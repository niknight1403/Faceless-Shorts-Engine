# API nur lokal freigeben, sofern kein bewusster externer Zugriff nötig ist.
HOST=127.0.0.1
PORT=3000

# Lokaler Test-Medienanbieter aus scripts/mock-media-provider.mjs
MOCK_MEDIA_URL=http://127.0.0.1:4010

# Lokaler Pfad für Jobs und gerenderte Videos (wird von Git ignoriert)
JOB_DATA_DIR=./data/jobs

# Standarddauer des PoC-Exports sowie ausführbare Medienprogramme
DEFAULT_DURATION_SECONDS=5
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Publishing bleibt standardmäßig deaktiviert.
# Zum Aktivieren: PUBLISHING_ENABLED=true, einen zufälligen API-Key (mindestens 32 Zeichen)
# und einen base64url-kodierten 32-Byte-Schlüssel setzen. Schlüssel z.B. mit:
# node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
PUBLISHING_ENABLED=false
PUBLISHING_API_KEY=
PUBLISHING_TOKEN_KEY=
PUBLISHING_DATA_DIR=./data/publishing

# OAuth-Zugangsdaten nur lokal in .env setzen, niemals committen.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/v1/connections/youtube/oauth/callback
TIKTOK_OAUTH_CLIENT_ID=
TIKTOK_OAUTH_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/v1/connections/tiktok/oauth/callback

# TikTok bleibt bis zur jeweiligen App-Prüfung gesperrt.
TIKTOK_UPLOAD_APPROVED=false
TIKTOK_DIRECT_POST_APPROVED=false
