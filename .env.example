NODE_ENV=development
DATABASE_URL=postgresql://shorts:shorts@localhost:5432/shorts_engine?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=shorts-assets
AI_PROVIDER=mock
TTS_PROVIDER=mock
VIDEO_RENDER_PROVIDER=local-ffmpeg

# Free LLM Route Hunter (local-first; missing credentials skip cloud routes)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_FREE_TRIAL_ENABLED=false
CEREBRAS_MODEL=gpt-oss-120b
GROQ_API_KEY=
GROQ_FREE_TIER_ENABLED=false
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_FREE_TIER_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FREE_TIER_ENABLED=false
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional JSON array; each custom endpoint must explicitly set free:true
FREE_LLM_CUSTOM_ROUTES=

# Free TTS cascade
MEDIA_STORAGE_DIR=./data/media
PIPER_MODEL=
PIPER_BIN=piper
KOKORO_TTS_BASE_URL=
KOKORO_TTS_MODEL=kokoro
KOKORO_TTS_VOICE=
KOKORO_TTS_API_KEY=
OPENROUTER_TTS_MODEL=
OPENROUTER_TTS_VOICE=
TTS_AI_ENABLED=true
TTS_AI_VOICE=de_DE-thorsten-medium
