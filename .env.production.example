# Copy to .env and replace every placeholder with unique random values.
NODE_ENV=production
POSTGRES_USER=shorts
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=shorts_engine
API_BIND=127.0.0.1
API_PORT=4000
DATABASE_URL=postgresql://shorts:CHANGE_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/shorts_engine?schema=public
REDIS_URL=redis://redis:6379
API_ACCESS_TOKEN=CHANGE_TO_A_LONG_RANDOM_SERVER_ONLY_TOKEN
ASSET_SIGNING_SECRET=CHANGE_TO_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_SECRET=CHANGE_TO_ANOTHER_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
MEDIA_STORAGE_DIR=/var/lib/faceless-shorts/media
FFMPEG_BIN=ffmpeg
WORKER_CONCURRENCY=1

# First administrator bootstrap (one-off trusted environment; never ship in mobile app)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_TO_A_NEW_RANDOM_PASSWORD_AT_LEAST_14_CHARS

# Enable only providers with valid credentials and confirmed free-tier eligibility.
AGENTFORGE_HUB_URL=
AGENTFORGE_HUB_TOKEN=
AGENTFORGE_HUB_FREE_ONLY_CONFIRMED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_FREE_TRIAL_ENABLED=false
CEREBRAS_MODEL=gpt-oss-120b
GROQ_API_KEY=
GROQ_FREE_TIER_ENABLED=false
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_FREE_TIER_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FREE_TIER_ENABLED=false
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
FREE_LLM_CUSTOM_ROUTES=

PIPER_MODEL=
PIPER_BIN=piper
KOKORO_TTS_BASE_URL=
KOKORO_TTS_MODEL=kokoro
KOKORO_TTS_VOICE=
KOKORO_TTS_API_KEY=
OPENROUTER_TTS_MODEL=
OPENROUTER_TTS_VOICE=
TTS_AI_ENABLED=false # Set true only after accepting external narration-text processing; otherwise configure Piper/Kokoro/eligible free TTS
