# Copy to .env.production and replace every placeholder before deployment.
POSTGRES_PASSWORD=replace-this-with-a-long-random-password
DATABASE_URL=postgresql://shorts:replace-this-with-a-url-encoded-password@postgres:5432/shorts_engine?schema=public
REDIS_URL=redis://redis:6379
ASSET_SIGNING_SECRET=replace-this-with-a-distinct-random-secret-at-least-32-characters
API_ACCESS_TOKEN=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-this-with-a-new-random-password-at-least-14-characters
